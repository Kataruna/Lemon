<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lemon.App.Wheel.WheelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lemon conversion wheel">
    <Grid
        x:Name="Root"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        Background="Transparent">
        <!-- The wheel's own disc, anti-aliased; the window region only trims the corners, just outside it. -->
        <Ellipse
            x:Name="Disc"
            Width="316"
            Height="316"
            Margin="0,2,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Canvas x:Name="Ring" Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</Window>
