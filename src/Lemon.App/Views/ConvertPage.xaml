<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lemon.App.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lemon.App.Views"
    xmlns:vm="using:Lemon.App.ViewModels"
    Background="Transparent">

    <Grid
        x:Name="DropRoot"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        Background="Transparent"
        Padding="24,16,24,16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="OnAddFiles" AutomationProperties.Name="Add files">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Add files" />
                </StackPanel>
            </Button>
            <Button Click="OnAddFolder" AutomationProperties.Name="Add folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <DropDownButton
                x:Name="SetAllButton"
                IsEnabled="{x:Bind views:Ui.Not(Queue.IsEmpty), Mode=OneWay}"
                ToolTipService.ToolTip="Use one preset for every file of a type" AutomationProperties.Name="Set all to">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                    <TextBlock Text="Set all to" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="SetAllMenu" Placement="BottomEdgeAlignedLeft" Opening="OnSetAllOpening" />
                </DropDownButton.Flyout>
            </DropDownButton>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind views:Ui.VisibleIfAnyText(Queue.Notice, Queue.MissingToolsMessage), Mode=OneWay}">
            <InfoBar
                Severity="Warning"
                IsOpen="{x:Bind views:Ui.HasText(Queue.Notice), Mode=OneWay}"
                Message="{x:Bind Queue.Notice, Mode=OneWay}"
                CloseButtonClick="OnNoticeClosed" />
            <InfoBar
                Severity="Informational"
                Title="More formats available"
                IsClosable="False"
                IsOpen="{x:Bind views:Ui.HasText(Queue.MissingToolsMessage), Mode=OneWay}"
                Message="{x:Bind Queue.MissingToolsMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Empty state -->
        <Grid Grid.Row="2" Visibility="{x:Bind views:Ui.Visible(Queue.IsEmpty), Mode=OneWay}">
            <Rectangle
                x:Name="EmptyDropOutline"
                RadiusX="12"
                RadiusY="12"
                Stroke="{ThemeResource TextFillColorTertiaryBrush}"
                StrokeThickness="2"
                StrokeDashArray="4,3" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Image Source="ms-appx:///Assets/Lemon.png" Width="72" Height="72" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Drop files here to convert" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Images, audio, video and documents. Folders work too." />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="Browse files…"
                    Click="OnAddFiles" />
            </StackPanel>
        </Grid>

        <!-- Queue -->
        <ListView
            x:Name="JobList"
            Grid.Row="2"
            Margin="-4,0"
            SelectionMode="None"
            ItemsSource="{x:Bind Queue.Jobs}"
            Visibility="{x:Bind views:Ui.Collapsed(Queue.IsEmpty), Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:JobViewModel">
                    <Border Style="{StaticResource CardStyle}" Padding="14,10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="200" />
                                <!-- Fixed so the preset box doesn't jump when action buttons appear. -->
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind InputPath}" />
                                <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Convert to"
                                PlaceholderText="No converter"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind AvailablePresets, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedPreset, Mode=TwoWay}"
                                IsEnabled="{x:Bind IsEditable, Mode=OneWay}" />

                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                <ProgressBar
                                    Maximum="1"
                                    Value="{x:Bind Progress, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    Visibility="{x:Bind views:Ui.Visible(ShowProgress), Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind views:Ui.Collapsed(ShowProgress), Mode=OneWay}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind views:Ui.Visible(IsDone), Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind views:Ui.Visible(IsFailed), Mode=OneWay}" />
                                    <TextBlock
                                        MaxWidth="180"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind OpenOutputCommand}" Visibility="{x:Bind views:Ui.Visible(IsDone), Mode=OneWay}" ToolTipService.ToolTip="Open" AutomationProperties.Name="Open converted file">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind ShowInFolderCommand}" Visibility="{x:Bind views:Ui.Visible(IsDone), Mode=OneWay}" ToolTipService.ToolTip="Show in folder" AutomationProperties.Name="Show in folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="OnRetry" Tag="{x:Bind}" Visibility="{x:Bind views:Ui.Visible(CanRetry), Mode=OneWay}" ToolTipService.ToolTip="Try again" AutomationProperties.Name="Try again">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Command="{x:Bind CancelCommand}" Visibility="{x:Bind views:Ui.Visible(IsActive), Mode=OneWay}" ToolTipService.ToolTip="Cancel" AutomationProperties.Name="Cancel conversion">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="OnRemove" Tag="{x:Bind}" Visibility="{x:Bind views:Ui.Collapsed(IsActive), Mode=OneWay}" ToolTipService.ToolTip="Remove from list" AutomationProperties.Name="Remove from list">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Drop highlight while dragging over a non-empty queue -->
        <Border
            x:Name="DropOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="-12"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            CornerRadius="12"
            BorderThickness="2"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Drop to add" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Queue.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton x:Name="OutputFolderLink" Padding="4,2" Click="OnOutputFolderClick" ToolTipService.ToolTip="Change in Settings" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear finished" Click="OnClearFinished" IsEnabled="{x:Bind Queue.HasFinishedJobs, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Clear all" Click="OnClearAll" IsEnabled="{x:Bind views:Ui.Not(Queue.IsEmpty), Mode=OneWay}" />
            <Button
                Grid.Column="3"
                Click="OnCancelAll"
                Visibility="{x:Bind views:Ui.Visible(Queue.IsBusy), Mode=OneWay}" AutomationProperties.Name="Cancel all">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="14" Height="14" IsActive="True" />
                    <TextBlock Text="Cancel all" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="4"
                MinWidth="120"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnConvert"
                IsEnabled="{x:Bind Queue.HasStartableJobs, Mode=OneWay}" AutomationProperties.Name="Convert">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Convert" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
