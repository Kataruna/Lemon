<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lemon.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lemon.App.Views"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Output" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <RadioButtons x:Name="OutputChoice" Header="Save converted files" SelectionChanged="OnOutputChoiceChanged">
                        <x:String>Next to the original file</x:String>
                        <x:String>In a folder I choose</x:String>
                    </RadioButtons>
                    <StackPanel x:Name="CustomFolderPanel" Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                        <TextBlock x:Name="OutputFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                        <Button Content="Choose…" Click="OnChooseOutputFolder" />
                    </StackPanel>
                    <NumberBox
                        x:Name="ParallelBox"
                        Header="Files to convert at the same time"
                        HorizontalAlignment="Left"
                        MinWidth="220"
                        Minimum="1"
                        Maximum="16"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnParallelChanged" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Running in the background" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="TraySwitch" Header="Keep Lemon in the notification area when I close the window" Toggled="OnTrayToggled" />
                    <ToggleSwitch x:Name="StartupSwitch" Header="Start Lemon when I sign in to Windows" Toggled="OnStartupToggled" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="While Lemon is in the notification area, the conversion wheel keeps working and conversion errors pop up as notifications. Right-click the lemon icon to quit." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Conversion wheel" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        TextWrapping="Wrap"
                        Text="While you drag files anywhere in Windows, open a wheel of formats under the pointer. Drop the files on a format to convert them straight away, or on the lemon in the middle to add them to the queue." />
                    <ToggleSwitch x:Name="ShakeSwitch" Header="Open it by shaking the mouse while dragging" Toggled="OnShakeToggled" />
                    <ComboBox x:Name="WheelKeyBox" Header="Or by pressing a key while dragging" MinWidth="220" SelectionChanged="OnWheelKeyChanged" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="The key is only taken over during a drag; the rest of the time it works as usual. Lemon has to be running for the wheel to appear (minimized is fine)." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="File Explorer" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="ContextMenuSwitch" Header="Show “Convert with Lemon” when you right-click a file" Toggled="OnContextMenuToggled" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="On Windows 11 it appears under “Show more options” (or Shift + right-click). It points to this copy of Lemon, so turn it off and on again if you move the app." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Converters" VerticalAlignment="Center" />
                <HyperlinkButton Content="Check again" Click="OnRecheckTools" />
            </StackPanel>
            <Border Style="{StaticResource CardStyle}" Padding="16,8">
                <ItemsControl x:Name="ToolList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:ToolStatus">
                            <Grid ColumnSpacing="12" Padding="0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Purpose}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="{x:Bind DetailFont}" />
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Content="Locate…" Tag="{x:Bind Tool}" Click="OnLocateTool" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Background remover" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="16,8">
                <StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" Margin="0,6,0,0"
                        Text="“Remove background” uses a BiRefNet AI model that runs on this PC. The models are too big to ship with Lemon, so download the one you want (checked and saved in the Lemon folder)." />
                    <ItemsControl x:Name="ModelList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:ModelRow">
                                <Grid ColumnSpacing="12" Padding="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Purpose}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" Visibility="{x:Bind views:Ui.Visible(IsBusy), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Content="{x:Bind ButtonText, Mode=OneWay}" Tag="{x:Bind}" Click="OnModelAction" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="VersionText" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Images are converted with the built-in ImageMagick. Audio and video use FFmpeg. Documents use Pandoc and LibreOffice when they're installed." />
                    <HyperlinkButton Content="Open settings folder" Click="OnOpenSettingsFolder" Padding="0,4" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
