<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lemon.App.Views.WheelSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Lemon.App.Views"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Viewbox x:Name="PreviewBox" Height="300" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="PreviewCaption"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Opening the wheel" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <views:WheelTriggers />
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Look" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ComboBox x:Name="ThemeBox" Header="Theme" MinWidth="220" SelectionChanged="OnThemeChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <DropDownButton x:Name="AccentButton" AutomationProperties.Name="Accent color">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="AccentSwatch" Width="16" Height="16" CornerRadius="4" />
                                <TextBlock Text="Accent color" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" ColorChanged="OnAccentChanged" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <TextBlock x:Name="AccentNote" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Follows your Windows accent color" />
                    </StackPanel>
                    <Slider x:Name="TintSlider" Header="Accent tint on the wheel" Minimum="0" Maximum="0.5" StepFrequency="0.01" MaxWidth="360" HorizontalAlignment="Left" ValueChanged="OnTintChanged" />
                    <RadioButtons x:Name="BlurChoice" Header="Blur what's behind the wheel" MaxColumns="4" SelectionChanged="OnBlurChanged" />
                    <Slider x:Name="OpacitySlider" Header="Opacity (lower shows more of what's behind the wheel)" Minimum="0.3" Maximum="1" StepFrequency="0.05" MaxWidth="360" HorizontalAlignment="Left" ValueChanged="OnOpacityChanged" />
                    <TextBox x:Name="CenterBox" Header="In the middle (an emoji; 🍋 is Lemon's own lemon)" MaxWidth="360" HorizontalAlignment="Left" TextChanged="OnCenterChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="TextColorSwitch" Header="Custom text color" Toggled="OnTextColorToggled" />
                        <DropDownButton x:Name="TextColorButton" VerticalAlignment="Bottom" AutomationProperties.Name="Text color">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="TextColorSwatch" Width="16" Height="16" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <TextBlock Text="Text color" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="TextColorPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" ColorChanged="OnTextColorChanged" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rings" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel x:Name="BuiltInRingsPanel" Spacing="0" />
                    <StackPanel x:Name="CustomRingsPanel" Spacing="4" />
                    <Button x:Name="NewRingButton" Content="New ring…" Click="OnNewRing" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Make a ring of the tools you use together, like Optimize and Remove background. Rings you switch off are skipped by the mode bar, the hub, Tab, the number keys and the scroll wheel." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Opens on" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <ToggleSwitch x:Name="HubSwitch" Header="Open on the hub" Toggled="OnHubToggled" />
                    <ToggleSwitch x:Name="BackChipSwitch" Header="Back to the hub from a chip under the ring" Toggled="OnBackChipToggled" />
                    <StackPanel x:Name="OpensOnPanel" Spacing="8" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="The hub shows the rings themselves as slices; rest the files on one to open it, or press 0 to come back. Inside a ring, rest on the middle to go back to the hub, or turn on the chip under the ring instead. Without it, each kind of file opens on its own ring. With more than four rings, the hub is how you switch. If a ring has nothing for the files, the wheel opens on the hub or the first ring instead." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Convert ring" Margin="0,12,0,0" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="KindBox" Header="For" MinWidth="220" SelectionChanged="OnKindChanged" />
                    <StackPanel x:Name="SlotsPanel" Spacing="0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <DropDownButton x:Name="AddFormatButton" Content="Add format">
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="AddFormatMenu" Placement="Bottom" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button x:Name="ResetSlotsButton" Content="Reset" Click="OnResetSlots" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="Up to 8, clockwise from the top. Your own presets from the Presets page can go here too. Formats a file can't be converted to are skipped." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
